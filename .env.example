# =============================================================================
# AI KAREN - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and customize for your environment
# Last updated: 2026-08-27

# -----------------------------------------------------------------------------
# CORE ENVIRONMENT SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
ENVIRONMENT=development
SYSTEM_NAME=AI Karen Admin System

# -----------------------------------------------------------------------------
# BACKEND CONNECTIVITY
# -----------------------------------------------------------------------------
KAREN_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_KAREN_BACKEND_URL=http://localhost:8000
KAREN_BACKEND_PORT=8000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BASE_URL=http://localhost:8000
KAREN_FALLBACK_BACKEND_URLS=http://127.0.0.1:8000,http://host.docker.internal:8000
HEALTH_CHECK_INTERVAL_MS=30000

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET_KEY=change-me-in-production-secure-key

# Development auth settings. Tenant scope is never manufactured implicitly.
AUTH_DEV_MODE=false
AUTH_ALLOW_DEV_LOGIN=false
AUTH_MODE=hybrid
SIMPLE_AUTH_ENABLED=true
KAREN_DEV_TENANT_ID=replace-with-explicit-dev-tenant-id

AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_HTTPONLY=true
AUTH_SESSION_COOKIE_SAMESITE=lax
AUTH_SESSION_TIMEOUT_HOURS=24

AUTH_ENABLE_SECURITY_FEATURES=false
AUTH_ENABLE_RATE_LIMITING=false
AUTH_ENABLE_SESSION_VALIDATION=false
AUTH_ENABLE_INTELLIGENT_AUTH=false

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Supabase PostgreSQL - canonical)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Legacy local Postgres settings (kept for backward compatibility)
POSTGRES_USER=karen_user
POSTGRES_PASSWORD=karen_secure_pass_change_me
POSTGRES_DB=ai_karen
POSTGRES_PORT=5432

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO=false

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_PASSWORD=redis_secure_pass_change_me
REDIS_PORT=6380
REDIS_URL=redis://:redis_secure_pass_change_me@localhost:6380/0

# -----------------------------------------------------------------------------
# OBJECT STORAGE (Supabase Storage)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=artifacts

# -----------------------------------------------------------------------------
# VECTOR DATABASE (PostgreSQL + pgvector - canonical)
# -----------------------------------------------------------------------------
# pgvector is provided by PostgreSQL; no separate vector DB required.

# -----------------------------------------------------------------------------
# ELASTICSEARCH CONFIGURATION (retired)
# -----------------------------------------------------------------------------
# ELASTICSEARCH_HOST=localhost
# ELASTICSEARCH_PORT=9200

# -----------------------------------------------------------------------------
# PERFORMANCE & RESOURCE OPTIMIZATION
# -----------------------------------------------------------------------------
KAREN_MAX_MEMORY_MB=4096
KAREN_MAX_CPU_PERCENT=80.0
KAREN_RESOURCE_CHECK_INTERVAL=15.0
KARI_ENABLE_CPU_OPTIMIZATION=true
KARI_CPU_CORES=4
KARI_ENABLE_PARALLEL_PROCESSING=true
KARI_ENABLE_MEMORY_OPTIMIZATION=true
KARI_ENABLE_BATCH_PROCESSING=true
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4

# -----------------------------------------------------------------------------
# LAZY LOADING & STARTUP OPTIMIZATION
# -----------------------------------------------------------------------------
KARI_LAZY_LOADING=true
KARI_MINIMAL_STARTUP=true
KARI_ULTRA_MINIMAL=true
KARI_DEFER_HEAVY_SERVICES=true
KARI_ESSENTIAL_ONLY=true
KARI_FAST_STARTUP=true
KARI_SERVICE_IDLE_TIMEOUT=180.0
KARI_CLEANUP_INTERVAL=60
MAX_CONCURRENT_MODELS=1
MODEL_CACHE_SIZE=1
ENABLE_MODEL_UNLOADING=true
MODEL_IDLE_TIMEOUT=30

# -----------------------------------------------------------------------------
# MEMORY MANAGEMENT
# -----------------------------------------------------------------------------
KARI_ENABLE_MEMORY_SERVICE=true
KARI_ENABLE_UNIFIED_MEMORY=true
KARI_MEMORY_SERVICE_TIMEOUT=30
KARI_MEMORY_FALLBACK_ENABLED=true

# Canonical bounded STM/session settings. Redis is the current physical backing;
# these values describe memory semantics and remain valid behind another adapter.
MEMORY_STM_SESSION_TTL_SECONDS=86400
MEMORY_STM_MAX_SLOT_BYTES=65536

# -----------------------------------------------------------------------------
# MODEL & AI PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
LLAMA_CPP_MODELS_DIR=./models/gguf
TRANSFORMERS_MODELS_DIR=./models/transformers
MODELS_ROOT=./models
PLUGIN_DIR=/app/plugin_marketplace
CONFIG_PATH=/app/config
SPACY_PIPELINES=en_core_web_sm
# OPENAI_API_KEY=your-openai-key-here
# GEMINI_API_KEY=your-gemini-key-here
# HUGGINGFACE_API_KEY=your-huggingface-key-here
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1

# -----------------------------------------------------------------------------
# MODEL ORCHESTRATOR CONFIGURATION
# -----------------------------------------------------------------------------
MODEL_ORCHESTRATOR_ENABLED=true
MODEL_ORCHESTRATOR_MAX_STORAGE_GB=100
MODEL_ORCHESTRATOR_ENABLE_METRICS=true
MODEL_ORCHESTRATOR_ENABLE_RBAC=true

# -----------------------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_ENABLED=true
EMAIL_TEST_MODE=true
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ai-karen.com
EMAIL_FROM_NAME=AI Karen Admin System

# -----------------------------------------------------------------------------
# TIMEOUT & RETRY CONFIGURATION
# -----------------------------------------------------------------------------
AUTH_TIMEOUT_MS=45000
CONNECTION_TIMEOUT_MS=30000
HEALTH_CHECK_TIMEOUT_MS=10000
DATABASE_TIMEOUT_MS=30000
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=10000
RETRY_EXPONENTIAL_BASE=2
ENABLE_EXPONENTIAL_BACKOFF=true

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8010,http://127.0.0.1:8010,http://localhost:3000

# -----------------------------------------------------------------------------
# GRAFANA CONFIGURATION
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_IMAGE=prom/prometheus:v2.47.0
GRAFANA_IMAGE=grafana/grafana:9.5.2

# -----------------------------------------------------------------------------
# NEXT.JS CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_DISABLE_MINIFICATION=true
NEXT_PUBLIC_USE_PROXY=true

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
KARI_ENABLE_SUPABASE_STORAGE=true
KARI_ENABLE_SUPABASE_REALTIME=true
KARI_ENABLE_SUPABASE_QUEUES=true
KAREN_ENABLE_HEALTH_CHECKS=true
ALLOW_PUBLIC_COPILOT=true

# -----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS
# -----------------------------------------------------------------------------
DEBUG=true
NEXT_PUBLIC_DEBUG=true
KARI_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# vLLM CONFIGURATION (OPTIONAL / LEGACY COMPATIBILITY)
# -----------------------------------------------------------------------------
KAREN_BUILTIN_VLLM_ENABLED=true
KAREN_BUILTIN_VLLM_BASE_URL=http://vllm:8000/v1
KAREN_BUILTIN_VLLM_HEALTH_URL=http://vllm:8000/health
KAREN_BUILTIN_VLLM_HOST_PORT=8001
KAREN_BUILTIN_VLLM_SERVED_MODEL_NAME=auto
KAREN_BUILTIN_VLLM_MODEL_ID=/models/transformers/gpt2
VLLM_IMAGE=vllm/vllm-openai:v0.6.6
VLLM_ENABLE_CUDA_COMPATIBILITY=0
KAREN_BUILTIN_VLLM_DEVICE=cuda
KAREN_BUILTIN_VLLM_DTYPE=float16
KAREN_BUILTIN_VLLM_CPU_DTYPE=float32
KAREN_BUILTIN_VLLM_CPU_WORKER_CLS=vllm.worker.cpu_worker.CPUWorker
KAREN_BUILTIN_VLLM_CPU_BLOCK_SIZE=16
KAREN_BUILTIN_VLLM_CPU_TARGET_DEVICE=cpu
KAREN_BUILTIN_VLLM_GENERATION_CONFIG=auto
KAREN_BUILTIN_VLLM_GPU_MEMORY_UTILIZATION=0.80
KAREN_BUILTIN_VLLM_MAX_MODEL_LEN=1024
KAREN_BUILTIN_VLLM_TIMEOUT_SECONDS=120
KAREN_BUILTIN_VLLM_STREAMING_ENABLED=true
KAREN_BUILTIN_VLLM_FALLBACK_ELIGIBLE=true
VLLM_CPU_KVCACHE_SPACE=40
VLLM_CPU_NUM_OF_RESERVED_CPU=1
KAREN_BUILTIN_VLLM_HOST_BASE_URL=http://localhost:8001/v1
KAREN_BUILTIN_VLLM_HOST_HEALTH_URL=http://localhost:8001/health
KAREN_VLLM_ENABLED=false
KAREN_VLLM_BASE_URL=http://localhost:8001/v1
KAREN_VLLM_MODEL=auto
KAREN_VLLM_SERVED_MODEL_NAME=auto
KAREN_VLLM_PORT=8001
KAREN_VLLM_MAX_MODEL_LEN=1024
KAREN_VLLM_DTYPE=auto
KAREN_VLLM_GPU_MEMORY_UTILIZATION=0.85
HUGGING_FACE_HUB_TOKEN=
