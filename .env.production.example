# AI Karen production environment template
# Copy to .env.production and replace every CHANGE_ME value before deployment.
# Never commit .env.production.

ENVIRONMENT=production
DEBUG=false
AUTH_DEV_MODE=false
AUTH_ALLOW_DEV_LOGIN=false
KARI_AUTH_BYPASS=false
KARI_FAST_STARTUP=false
KARI_SKIP_STARTUP_CHECK=false
KARI_SKIP_AUTO_INIT=false
KARI_DEFER_ROUTER_WIRING=false
EXTENSION_DEV_BYPASS_ENABLED=false
EXTENSION_REQUIRE_HTTPS=true
ALLOW_PUBLIC_COPILOT=false

# Generate independent cryptographically random secrets of at least 32 bytes.
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_PLUS_BYTES
AUTH_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_PLUS_BYTES
AUTH_JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_PLUS_BYTES
EXTENSION_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_PLUS_BYTES
EXTENSION_API_KEY=CHANGE_ME_GENERATE_RANDOM_32_PLUS_BYTES

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# PostgreSQL / Supabase-compatible PostgreSQL
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/CHANGE_ME_DB
POSTGRES_URL=postgresql+asyncpg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/CHANGE_ME_DB
AUTH_DATABASE_URL=postgresql+asyncpg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/CHANGE_ME_DB
DATABASE_PASSWORD=CHANGE_ME_PASSWORD
DB_HOST=CHANGE_ME_HOST
DB_PORT=5432
DB_USER=CHANGE_ME_USER
DB_NAME=CHANGE_ME_DB

# Optional observability profile. Required when Grafana is enabled.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# Provider credentials are optional and should only be configured for providers
# explicitly enabled by the deployment. Keep Karen local-first by default.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
