# =============================================================================
# AI KAREN - PLUGIN ECOSYSTEM DOCKERFILE
# =============================================================================
# Production Docker image for the plugin ecosystem
# Last updated: 2026-04-04

# Stage 1: Base Image
FROM python:3.12-slim as base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=0 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    git \
    curl \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    libjpeg-dev \
    libpng-dev \
    libffi-dev \
    libssl-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Stage 2: Build Dependencies
FROM base as builder

# Set working directory
WORKDIR /build

# Copy requirements files
COPY requirements.txt requirements-database.txt /build/

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /build/requirements.txt && \
    pip install --no-cache-dir -r /build/requirements-database.txt && \
    rm -rf /root/.cache/pip

# Stage 3: Production Image
FROM python:3.12-slim as production

# Install runtime-only system dependencies required by health probes.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r karen && useradd -r -g karen karen

# Set working directory
WORKDIR /app

# Canonical import root used by the production API image.
ENV PYTHONPATH=/app/src

# Copy necessary files from builder stage
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY src/ /app/src/

# Create necessary directories
RUN mkdir -p /var/lib/karen/plugins \
    /var/cache/karen/plugins \
    /tmp/karen/plugins \
    /var/log/karen \
    /var/backups/karen/plugins \
    /app/static/plugins

# Set ownership of directories
RUN chown -R karen:karen /app /var/lib/karen /var/cache/karen /tmp/karen /var/log/karen /var/backups/karen /app/static

# Keep the container entrypoint aligned with the canonical API runtime.
RUN pip install --no-cache-dir uvicorn[standard] psycopg2-binary redis

# Security hardening
RUN chmod 755 /app/src && \
    chmod 750 /var/log/karen && \
    chmod 750 /var/lib/karen && \
    chmod 750 /var/cache/karen && \
    chmod 1777 /tmp/karen

# Switch to non-root user
USER karen

# Liveness only: optional plugin/provider degradation must not restart the process.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -fsS http://localhost:8000/health/live || exit 1

# Expose ports
EXPOSE 8000

# Reuse the canonical production ASGI application factory.
CMD ["python", "-m", "uvicorn", "ai_karen_engine.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]

# Labels for metadata
LABEL maintainer="Karen AI Platform Team" \
      version="1.0.0" \
      description="Production plugin ecosystem image" \
      org.opencontainers.image.source=https://github.com/agustealo/AI-Karen \
      org.opencontainers.image.licenses=MPL-2.0