{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-karen:kcm:dataset-manifest:v1",
  "title": "KCM Dataset Manifest v1 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "tenant_id",
    "owner_user_id",
    "objective_id",
    "objective_version",
    "status",
    "content_sha256",
    "selection_recipe",
    "members",
    "split_strategy",
    "governance",
    "created_at",
    "policy_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "format": "uuid"
    },
    "dataset_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "objective_id": {
      "type": "string",
      "minLength": 1
    },
    "objective_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "frozen",
        "revoked",
        "superseded"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selection_recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "version",
        "config_sha256",
        "seed"
      ],
      "properties": {
        "recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assessment_id",
          "source_artifact_id",
          "source_revision",
          "content_sha256",
          "leakage_group_id",
          "split",
          "consent_receipt_id",
          "rights_receipt_id",
          "verification_receipt_id"
        ],
        "properties": {
          "assessment_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "leakage_group_id": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "train",
              "dev",
              "test"
            ]
          },
          "consent_receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "rights_receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "verification_receipt_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "split_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "leakage_group_fields",
        "test_locked"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "leakage_group_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "test_locked": {
          "type": "boolean"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consent_policy_version",
        "license_policy_version",
        "deletion_epoch",
        "revocation_check_at"
      ],
      "properties": {
        "consent_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "license_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "deletion_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "revocation_check_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "model_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_model_id": {
          "type": "string",
          "minLength": 1
        },
        "tokenizer_revision": {
          "type": "string",
          "minLength": 1
        },
        "chat_template_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_user_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
