        "admin.health:read",
        "admin.memory:manage",
        "admin.memory:read",
        "admin.plugins:manage",
        "admin.plugins:read",
        "admin.providers:manage",
        "admin.providers:read",
        "admin.runtime:manage",
        "admin.runtime:read",
        "admin.tenants:manage",
        "admin.tenants:read",
        "admin.users:manage",
        "admin.users:read",
        "admin:read",
        "admin:system",
        "admin:write",
        "audit:read",
        "data:read",
        "data:write",
        "plugins:manage",
        "read",
        "scheduler:execute",
        "scheduler:read",
        "scheduler:write",
        "system:configure",
        "training:delete",
        "training:execute",
        "training:read",
        "training:write",
        "training_data:delete",
        "training_data:read",
        "training_data:write",
