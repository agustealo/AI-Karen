{
  "id": "file-explorer",
  "name": "file-explorer",
  "display_name": "File Explorer",
  "version": "0.2.0",
  "description": "Standalone shared file and folder explorer for host-authorized inventory snapshots; no direct filesystem access.",
  "purpose": "Provide one governed explorer capability reusable by other extensions.",
  "author": "KAREN Engineering",
  "license": "MIT",
  "category": "integration",
  "entrypoint": "handler:MainExtension",
  "tags": [
    "files",
    "folders",
    "shared-capability",
    "explorer",
    "local-first"
  ],
  "capabilities": {
    "provides_ui": true,
    "provides_api": false,
    "prompt_first": true
  },
  "prompt_files": {
    "mode": "none",
    "prompt_first": true
  },
  "rbac": {
    "allowed_roles": [
      "user",
      "admin",
      "developer"
    ],
    "default_enabled": false
  },
  "permissions": {
    "memory_read": false,
    "memory_write": false,
    "user_data_read": false,
    "user_data_write": false,
    "network_access": []
  },
  "resources": {
    "max_memory_mb": 128,
    "max_cpu_percent": 20,
    "max_disk_mb": 50,
    "enforcement_action": "default"
  },
  "execution_input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "list",
          "select"
        ]
      },
      "parent_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "source_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 24,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "required": [
      "operation"
    ],
    "additional_properties": false
  },
  "ui": {
    "hook_zones": [
      {
        "zone": "sidebar.plugins",
        "label": "File Explorer",
        "icon": "folder-open",
        "order": 35
      }
    ],
    "source_path": "ui",
    "entry_file": "FileExplorerPage.tsx",
    "menu": [
      {
        "zone": "sidebar.plugins",
        "label": "File Explorer",
        "icon": "folder-open",
        "order": 35
      }
    ]
  },
  "entry": {
    "id": "file-explorer-main",
    "default": true,
    "entry_file": "FileExplorerPage.tsx"
  }
}
