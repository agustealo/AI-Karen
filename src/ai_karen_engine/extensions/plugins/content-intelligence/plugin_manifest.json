{
  "id": "content-intelligence",
  "name": "content-intelligence",
  "display_name": "Content Intelligence",
  "version": "0.2.0",
  "description": "Standalone bounded analysis of host-authorized text sources with a governed investigation workspace.",
  "purpose": "Analyze authorized invocation-supplied content without accessing files, global memory or external indexes.",
  "author": "KAREN Engineering",
  "license": "MIT",
  "category": "integration",
  "entrypoint": "handler:MainExtension",
  "tags": [
    "documents",
    "folders",
    "knowledge",
    "local-first",
    "retrieval"
  ],
  "capabilities": {
    "provides_ui": true,
    "provides_api": false,
    "prompt_first": true
  },
  "prompt_files": {
    "prompt_first": true,
    "mode": "none"
  },
  "permissions": {
    "memory_read": false,
    "memory_write": false,
    "user_data_read": false,
    "user_data_write": false,
    "network_access": []
  },
  "rbac": {
    "allowed_roles": [
      "user",
      "admin",
      "developer"
    ],
    "default_enabled": false
  },
  "resources": {
    "max_memory_mb": 256,
    "max_cpu_percent": 25,
    "max_disk_mb": 100,
    "enforcement_action": "default"
  },
  "execution_input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "analyze",
          "search",
          "compare"
        ]
      },
      "documents": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "folder_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "required": [
            "id",
            "name",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "left_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "right_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "operation",
      "documents"
    ],
    "additional_properties": false
  },
  "ui": {
    "hook_zones": [
      {
        "zone": "sidebar.plugins",
        "label": "Content Intelligence",
        "icon": "brain-circuit",
        "order": 36
      }
    ],
    "source_path": "ui",
    "entry_file": "ContentIntelligencePage.tsx",
    "menu": [
      {
        "zone": "sidebar.plugins",
        "label": "Content Intelligence",
        "icon": "brain-circuit",
        "order": 36
      }
    ]
  }
}
