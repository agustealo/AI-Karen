{
  "name": "custom-local-vllm",
  "display_name": "vLLM Local Server",
  "description": "vLLM server running locally or in a container. Configure base_url to match your deployment.",
  "provider_type": "custom",
  "enabled": false,
  "priority": 50,
  "endpoint": {
