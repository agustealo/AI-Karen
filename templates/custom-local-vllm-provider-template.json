    "validation_timeout": 10
  },
  "models": [],
  "default_model": null,
  "capabilities": ["chat_completion", "text_generation", "streaming"],
  "limits": {
    "requests_per_minute": null,
    "tokens_per_minute": null,
    "concurrent_requests": 12,
    "max_context_length": 32768,
    "max_output_tokens": 4096,
    "daily_quota": null,
    "monthly_quota": null
